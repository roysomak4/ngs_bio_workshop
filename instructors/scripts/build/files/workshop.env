# Shortcuts used by every command in the hands-on guide.
# ~/.bashrc loads this at login; run `source ~/workshop.env` after editing it.
export SAMPLE=ngs_ws
export THREADS=4
export REF="$NGS_REF"
export R1="$HOME/data/ngs_ws_R1.fastq.gz"
export R2="$HOME/data/ngs_ws_R2.fastq.gz"
export BED="$HOME/data/ngs_ws_roi_sorted.bed"
export TRUTH="$HOME/data/ngs_ws_truth_vars.vcf.gz"
export WORK="$HOME/work"
export BAM="$WORK/$SAMPLE.realigned.bam"
