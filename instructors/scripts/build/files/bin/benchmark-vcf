.swatch { display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: var(--hard);
  border: 1px solid var(--line); vertical-align: -2px; margin-right: 6px; }
footer { color: var(--muted); font-size: .85rem; }
.theme-toggle { font: 600 .8rem system-ui, sans-serif; padding: 5px 11px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--fg); cursor: pointer; }
.theme-toggle:hover { border-color: var(--accent); }
.theme-toggle { position: fixed; top: 12px; right: 12px; z-index: 20; }
"""

THEME_HEAD = '<script>try{var t=localStorage.getItem("ngs-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>'
THEME_BUTTON = '<button type="button" class="theme-toggle" id="theme-toggle"></button>'
THEME_JS = '<script>\n(function () {\n  // Light/dark toggle: follows the OS until clicked, then remembers the choice.\n  var root = document.documentElement, btn = document.getElementById("theme-toggle");\n  var media = matchMedia("(prefers-color-scheme: dark)");\n  function dark() { return root.dataset.theme ? root.dataset.theme === "dark" : media.matches; }\n  function label() {\n    var d = dark();\n    btn.textContent = d ? "\\u2600 Light" : "\\u263E Dark";\n    btn.setAttribute("aria-label", d ? "Switch to light theme" : "Switch to dark theme");\n  }\n  btn.addEventListener("click", function () {\n    root.dataset.theme = dark() ? "light" : "dark";\n    try { localStorage.setItem("ngs-theme", root.dataset.theme); } catch (e) {}\n    label();\n    document.dispatchEvent(new CustomEvent("themechange"));\n  });\n  media.addEventListener("change", label);\n  label();\n})();\n</script>\n'


def render_html(rounds, truth, sample):
    e = html.escape
    n = len(truth)
    out = []
    w = out.append
    w("<!doctype html><html lang='en'><head><meta charset='utf-8'>"
      "<meta name='viewport' content='width=device-width, initial-scale=1'>"
      f"<title>Benchmark · {e(sample)}</title><style>{CSS}</style>{THEME_HEAD}</head>"
      f"<body>{THEME_BUTTON}<main>")
    w(f"<header><h1>Benchmark against the truth set</h1><p class='meta'>Sample <b>{e(sample)}</b> · "
      f"{n} truth variants · {datetime.datetime.now():%d %b %Y, %H:%M}</p></header>")

    w("<section class='cards'>")
    for r in rounds:
        tp = sum(1 for c in r["hits"] if c)
        ncalls = r["ncalls"]
        prec = f"{(ncalls - len(r['fps'])) / ncalls:.0%}" if ncalls else "-"
        caller = f" · {e(r['caller'])}" if r["caller"] else ""
        w(f"<div class='card'><span class='label'>{e(r['label'])}</span>"
          f"<span class='file mono'>{e(r['file'])}{caller}</span>"
          f"<span class='big'>{tp}<small> / {n} found</small></span>"
          f"<div class='bar'><span style='width:{tp / n * 100:.0f}%'></span></div>"
          f"<div class='stats'><span>Sensitivity <b>{tp / n:.0%}</b></span>"
          f"<span>False pos. <b>{len(r['fps'])}</b></span><span>Precision <b>{prec}</b></span></div></div>")
    w("</section>")

    w("<section><h2>Truth variants</h2><div class='tbl'><table><thead><tr>"
      "<th>Gene</th><th>Position</th><th>Change</th><th class='num'>Expected</th>")
    for r in rounds:
        w(f"<th class='res'>{e(r['label'])}</th>")
    w("</tr></thead><tbody>")
    for i, t in enumerate(truth):
        hard = t["ins_len"] >= LONG_INS or (t["vaf"] is not None and t["vaf"] < LOW_VAF)
        w(f"<tr class='{'hard' if hard else ''}'><td>{e(t['gene'])}</td>"
          f"<td class='mono'><a href='/igv.html?locus={e(locus(t))}' title='Open in IGV'>"
          f"{e(t['chrom'])}:{t['pos']}</a></td><td class='mono'>{e(change(t))}</td>"
          f"<td class='num'>{pct(t['vaf'])}</td>")
        prev = None
        for r in rounds:
            c = r["hits"][i]
            new = " <span class='new'>NEW</span>" if c and prev is not None and not prev else ""
            cell = (f"<span class='pill found'>✓ {pct(c['vaf'])}</span>{new}" if c
                    else "<span class='pill miss'>missed</span>")
            w(f"<td class='res'>{cell}</td>")
            prev = c is not None
        w("</tr>")
    w("</tbody></table></div>")
    w(f"<p class='legend' style='margin-top:10px'><span><span class='swatch'></span>Hard to detect: "
      f"expected VAF below {LOW_VAF:.0%}, or an insertion longer than {LONG_INS} bp</span>"
      "<span><span class='new'>NEW</span> found in this round but not the one before</span>"
      "<span>Click a position to open it in IGV</span></p></section>")

    w("<section><h2>Calls not in the truth set</h2>")
    for r in rounds:
        fps = r["fps"]
        w(f"<details><summary>{e(r['label'])}: {len(fps)} call{'s' if len(fps) != 1 else ''}</summary>")
        if fps:
            w("<table><thead><tr><th>Position</th><th>Change</th><th class='num'>Observed VAF</th>"
              "</tr></thead><tbody>")
            for c in fps:
                w(f"<tr><td class='mono'><a href='/igv.html?locus={e(locus(c))}'>{e(c['chrom'])}:{c['pos']}</a>"
                  f"</td><td class='mono'>{e(change(c))}</td><td class='num'>{pct(c['vaf'])}</td></tr>")
            w("</tbody></table>")
        w("</details>")
    w("</section>")

    w("<footer>Calls outside the target BED are ignored. SNVs and short indels must match position, REF "
      "and ALT after left-normalisation. Insertions of 50 bp or more match any long insertion within one "
      "insertion length, since a tandem duplication can be written at several equivalent positions. "
      "Generated by <code>benchmark-vcf</code>.</footer></main>" + THEME_JS + "</body></html>")
    return "".join(out)


def main():
    home = os.path.expanduser("~")
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("calls", nargs="+")
    p.add_argument("--html", help="write a report comparing all VCFs to this file")
    p.add_argument("--labels", help="comma-separated names for the VCFs (default: Round 1, Round 2, ...)")
    p.add_argument("--truth", default=os.environ.get("TRUTH", f"{home}/data/ngs_ws_truth_vars.vcf.gz"))
    p.add_argument("--bed", default=os.environ.get("BED", f"{home}/data/ngs_ws_roi_sorted.bed"))
    p.add_argument("--ref", default=os.environ.get("REF") or os.environ.get("NGS_REF"))
    a = p.parse_args()
    if not a.ref:
        sys.exit("reference not set: source ~/workshop.env or pass --ref")
    labels = a.labels.split(",") if a.labels else [f"Round {i + 1}" for i in range(len(a.calls))]
    if len(labels) != len(a.calls):
        sys.exit(f"--labels has {len(labels)} names for {len(a.calls)} VCFs")

    norm = ["bcftools", "norm", "-f", a.ref, "-m", "-any", "--check-ref", "w"]
    truth, _ = parse(run(norm + [a.truth]))
    regions = load_bed(a.bed)

    rounds = []
    for label, path in zip(labels, a.calls):
        records, caller = parse(run(norm + [path]))
        calls = [c for c in records if in_bed(regions, c["chrom"], c["pos"])]
        hits, fps = score(truth, calls)
        print_round(f"{label}: {path}", truth, hits, fps, len(calls))
        rounds.append({"label": label, "file": os.path.basename(path), "caller": caller,
                       "hits": hits, "fps": fps, "ncalls": len(calls)})

    if a.html:
        sample = os.environ.get("SAMPLE", "sample")
        os.makedirs(os.path.dirname(os.path.abspath(a.html)), exist_ok=True)
        with open(a.html, "w") as fh:
            fh.write(render_html(rounds, truth, sample))
        print(f"\nWrote {a.html}. Open it from the portal: QC reports.")


if __name__ == "__main__":
    main()
